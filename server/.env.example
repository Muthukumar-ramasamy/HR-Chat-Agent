# Copy to .env and fill in. Never commit .env.

# LLM provider: "anthropic" (default) or "google". Only the matching API key is needed.
LLM_PROVIDER=anthropic
# Optional; defaults to claude-haiku-4-5 (anthropic) or gemini-3.8-flash (google)
LLM_MODEL=

# Claude key from https://console.anthropic.com (Settings -> API Keys)
ANTHROPIC_API_KEY=your-anthropic-key

# Gemini key from https://aistudio.google.com/apikey (only if LLM_PROVIDER=google)
GOOGLE_API_KEY=your-google-ai-studio-key

# LangSmith tracing (optional). LangChain reads these automatically — no code needed.
# Free key at https://smith.langchain.com (Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=hr-agent

# API server (Stage 5). JWT_SECRET: 32+ random characters, e.g. generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-at-least-32-characters
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional: pin "today" (YYYY-MM-DD) so demo answers are reproducible
# APP_TODAY=2026-10-05

# SQLite file (synthetic data only)
DB_PATH=./data/hr.db
